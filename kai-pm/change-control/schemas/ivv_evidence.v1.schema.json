{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kai.cai.ivv_evidence.v1",
  "title": "CAI IV&V evidence record (a committed file, resolved by git-blob reference and hashed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository_id",
    "repository_full_name",
    "wa_id",
    "candidate_commit",
    "candidate_tree",
    "disposition",
    "reviewer",
    "summary"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "kai.cai.ivv_evidence.v1"
    },
    "repository_id": {
      "type": "integer",
      "const": 1004463473
    },
    "repository_full_name": {
      "type": "string",
      "const": "dainius1234/kai-system"
    },
    "wa_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "ACCEPT_FOR_ADMISSION",
        "REJECT"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    }
  }
}
