{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kai.cai.admission.v1",
  "title": "CAI admission record (payload of a signed tag under refs/tags/kai-admitted/)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository_id",
    "repository_full_name",
    "admission_id",
    "sequence",
    "wa_id",
    "candidate_commit",
    "candidate_tree",
    "ivv_evidence_ref",
    "ivv_evidence_sha256",
    "previous_admission_tag_object",
    "issuer",
    "note"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "kai.cai.admission.v1"
    },
    "repository_id": {
      "type": "integer",
      "const": 1004463473
    },
    "repository_full_name": {
      "type": "string",
      "const": "dainius1234/kai-system"
    },
    "admission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "wa_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ivv_evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commit",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "git-blob"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "pattern": "^[^\\x00-\\x1f\\x7f\\\\]{1,4096}$"
        }
      }
    },
    "ivv_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_admission_tag_object": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    }
  }
}
