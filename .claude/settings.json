{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/session-start.sh",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/ruling_capture.py report",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PROJECT_DIR}\"/.claude/skills/kai-handoff/handoff.py gate",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/handoff-hook.sh stop",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/ruling_capture.py stop",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/handoff-hook.sh precompact",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/ruling_capture.py prompt",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
